; رسائل برنامج التثبيت بالعربية (تكمّل الرسائل الافتراضية لـ Inno Setup)
[LangOptions]
LanguageName=العربية
LanguageID=$0401
LanguageCodePage=0
RightToLeft=yes
DialogFontName=Segoe UI
DialogFontSize=9
WelcomeFontName=Segoe UI
WelcomeFontSize=12

[Messages]
SetupAppTitle=التثبيت
SetupWindowTitle=تثبيت - %1
ButtonBack=< ال&سابق
ButtonNext=ال&تالي >
ButtonInstall=&تثبيت
ButtonCancel=إلغاء
ButtonFinish=إ&نهاء
WizardSelectTasks=المهام الإضافية
SelectTasksDesc=ما المهام الإضافية التي تريد تنفيذها؟
SelectTasksLabel2=اختر المهام الإضافية أثناء تثبيت [name]، ثم اضغط «التالي».
WizardReady=جاهز للتثبيت
ReadyLabel1=أصبح كل شيء جاهزاً لتثبيت [name] على جهازك.
WizardInstalling=جارٍ التثبيت
InstallingLabel=انتظر قليلاً حتى يُثبَّت [name] على جهازك.
FinishedHeadingLabel=اكتمل تثبيت [name]
FinishedLabel=ثُبّت [name] على جهازك، ويمكنك تشغيله من قائمة ابدأ أو من اختصار سطح المكتب.
ClickFinish=اضغط «إنهاء» لإغلاق نافذة التثبيت.
ExitSetupTitle=إلغاء التثبيت
ExitSetupMessage=لم يكتمل التثبيت. إن خرجت الآن فلن يُثبَّت البرنامج.%n%nهل تريد الخروج؟

[CustomMessages]
CreateDesktopIcon=إنشاء اختصار على سطح المكتب
AdditionalIcons=اختصارات إضافية:
LaunchProgram=تشغيل %1
